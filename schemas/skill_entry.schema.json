{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhenghh04/trinity_hub/schemas/skill_entry.schema.json",
  "title": "Trinity Hub skill entry",
  "description": "Public descriptor of a reusable skill registered in Trinity Hub. A pointer to where the skill lives, not the skill itself, and never a credential.",
  "type": "object",
  "required": ["schema", "id", "name", "owner", "maintainers", "description", "trigger", "domains", "source", "status", "added"],
  "additionalProperties": false,
  "properties": {
    "schema":      {"const": "trinity.hub.skill/v1"},
    "id":          {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64},
    "name":        {"type": "string", "minLength": 1},
    "owner":       {"type": "string", "minLength": 1},
    "maintainers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["github"], "additionalProperties": false,
        "properties": {
          "github":  {"type": "string", "minLength": 1},
          "contact": {"type": "string"}
        }
      }
    },
    "description":  {"type": "string", "minLength": 1, "maxLength": 600},
    "trigger":      {"type": "string", "minLength": 1},
    "domains":      {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "inputs":       {"type": "string"},
    "outputs":      {"type": "string"},
    "requirements": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["repo"],
      "additionalProperties": false,
      "properties": {
        "repo":    {"type": "string", "pattern": "^https://"},
        "path":    {"type": "string"},
        "license": {"type": "string"}
      }
    },
    "status": {"enum": ["active", "experimental", "deprecated"]},
    "added":  {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}
  }
}
